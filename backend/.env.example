PORT=4000
RPC_URL=http://127.0.0.1:8545
# Optional: overrides blockchain/deployments/localhost.json
AGENT_REGISTRY_ADDRESS=
CHAIN_ID=31337
NETWORK_NAME=localhost
REQUEST_MAX_AGE_SECONDS=300
CLOCK_SKEW_SECONDS=30
# Optional bounded eth_getLogs range. Defaults to 10 blocks for public RPC compatibility.
EVENT_SCAN_BLOCK_CHUNK=10
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
# Development-only lifecycle signing through unlocked Hardhat localhost accounts.
ENABLE_DEMO_SIGNING=false

# Optional persistent server-side storage. The service-role key must never be
# exposed to frontend code, API responses, logs, or committed files.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
